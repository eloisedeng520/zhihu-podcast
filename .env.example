# 知乎知识列表/正文使用官方无需鉴权的接口。
# 文本模型使用 Chat Completions 协议。
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
# 腾讯云 TextToVoice：凭证保存在后端，使用两种不同音色。
TTS_PROVIDER=doubao
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 使用临时凭证时填写；长期密钥留空。
TENCENT_SESSION_TOKEN=
TTS_HOST_VOICE=101001
TTS_GUEST_VOICE=101004
# 多观点节目按顺序为不同答主分配音色；留空则回退到 TTS_GUEST_VOICE。
TTS_GUEST_VOICES=101004,101005,101006
# 其他兼容 Speech 协议的服务：将 TTS_PROVIDER 改成 openai-compatible。
TTS_URL=
TTS_API_KEY=
TTS_MODEL=

# Doubao Speech API Key (new console); TTS_PROVIDER=doubao
DOUBAO_API_KEY=
# ASR 默认复用 DOUBAO_API_KEY；如使用独立识别凭证，可单独填写
DOUBAO_ASR_API_KEY=
DOUBAO_RESOURCE_ID=seed-tts-2.0
DOUBAO_HOST_VOICE=zh_female_mizai_uranus_bigtts
DOUBAO_GUEST_VOICE=zh_male_liufei_uranus_bigtts
# 多观点节目嘉宾音色池，填写账户已开通的不同音色 ID。
DOUBAO_GUEST_VOICES=zh_male_liufei_uranus_bigtts,zh_male_wennuanahu_uranus_bigtts,zh_female_tiexinnvsheng_uranus_bigtts,zh_female_xinlingjitang_uranus_bigtts,zh_male_m191_uranus_bigtts

# 语音提问识别（豆包录音文件极速版）
ASR_PROVIDER=doubao
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
# 知乎 OAuth：App Key 仅配置到后端环境 / 部署 Secret。
# token 在 D1 加密存储，浏览器仅持有随机会话 ID。
ZHIHU_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_REDIRECT_URI=http://localhost:3000/api/auth/zhihu/callback

# 宝塔 / 普通 Linux Node 部署。生产环境建议填写位于发布目录之外的绝对路径。
# 留空时分别使用 .runtime/app.db 和 .runtime/audio。
SQLITE_DATABASE_PATH=
AUDIO_STORAGE_PATH=
# Nginx 反向代理 HTTPS 时必须开启，确保同源写请求不会被误判。
VINEXT_TRUST_PROXY=1
# Node 服务只监听本机，由 Nginx 对外提供 80/443。
HOST=127.0.0.1
PORT=3000
